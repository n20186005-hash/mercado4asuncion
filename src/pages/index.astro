---
import '../styles/global.css';
import {
  BASE,
  attraction,
  gallery,
  sections,
  faqs,
  nearbyLandmarks,
  reviewHighlights,
  reviewNotes,
  sources,
} from '../config/site';

import Weather from '../components/Weather.astro';
import Services from '../components/Services.astro';
import Transport from '../components/Transport.astro';
import Plan from '../components/Plan.astro';
import History from '../components/History.astro';
import Science from '../components/Science.astro';

const siteUrl = (Astro.site?.toString().replace(/\/$/, '')) || BASE;
const canonical = `${siteUrl}/`;
const hero = gallery[0].src;
const ogImage = `${siteUrl}${hero}`;

/* ---------------------------------------------------------------- TDK / OG */
// Visitor-facing Spanish identity and planning metadata.
const title = `${attraction.shortName} ${attraction.city}: horarios, cómo llegar y qué comprar`;
const description = 'Mercado 4 de Asunción: referencia municipal para llegar al Paseo de los Yuyos, qué rubros encontrar y cómo confirmar horarios, domingos, pagos y servicios.';
const ogTitle = `${attraction.shortName} ${attraction.city} — Guía de visita, horarios y cómo llegar`;
const ogDescription = `Orientación para visitar el ${attraction.shortName} en ${attraction.city}: horarios, cómo llegar, ubicación en el mapa, qué comprar y consejos para tu visita.`;

/* ------------------------------------------------------- Structured data 1 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${siteUrl}/#attraction`,
  name: attraction.fullName,
  alternateName: [
    attraction.shortName,
    `${attraction.city} ${attraction.fullName}`,
    'Mercado Cuatro',
    'Mercado Municipal N° 4 Asunción',
  ],
  description: `Guía completa del visitante del ${attraction.fullName} (${attraction.shortName}) en ${attraction.city}, ${attraction.region}, ${attraction.country}.`,
  url: canonical,
  image: gallery.map((g) => `${siteUrl}${g.src}`),
  address: {
    '@type': 'PostalAddress',
    addressLocality: attraction.city,
    addressRegion: attraction.region,
    addressCountry: attraction.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: attraction.latitude,
    longitude: attraction.longitude,
  },
  hasMap: attraction.mapsShareUrl,
  sameAs: [attraction.mapsShareUrl],
};

/* ------------------------------------------------------- Structured data 2 */
const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${siteUrl}/#webpage`,
  url: canonical,
  name: title,
  description: description,
  inLanguage: 'es-PY',
  isPartOf: { '@type': 'WebSite', '@id': `${siteUrl}/#website`, url: canonical, name: `${attraction.shortName} ${attraction.city}`, inLanguage: 'es-PY' },
  about: { '@id': `${siteUrl}/#attraction` },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, caption: 'Ilustración geométrica, no fotografía ni plano del mercado' },
};

/* ------------------------------------------------------- Structured data 3 */
/* ------------------------------------------------------- Structured data 4 */
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

/* ------------------------------------------------------------ Textos fuente */
const ratingSourceLine = `Referencia fechada de terceros en Google Maps; no opiniones recopiladas por esta guía · ${attraction.syncDate} ·`;
const reviewsAttribution = `Consulta manual de Google Maps del ${attraction.syncDate}; no es actualización automática ni garantía de servicios.`;
const viewAllLabel = 'Ver todas las opiniones en Google Maps';

const breadcrumbTrail = [
  attraction.fullName,
  attraction.city,
  attraction.region,
  attraction.country,
];
---

<!doctype html>
<html lang="es-PY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="author" content={`${attraction.shortName} ${attraction.city}`} />

    <!-- Señales geográficas de la entidad -->
    <meta name="geo.region" content="PY" />
    <meta name="geo.placename" content={`${attraction.city}, ${attraction.country}`} />
    <meta name="ICBM" content={`${attraction.latitude}, ${attraction.longitude}`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${attraction.shortName} ${attraction.city}`} />
    <meta property="og:locale" content="es_PY" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Ilustración geométrica original, no fotografía ni plano del mercado" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Ilustración geométrica original, no fotografía ni plano del mercado" />

    <!-- PWA -->
    <meta name="theme-color" content="#16241d" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={attraction.shortName} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content={`${attraction.shortName} ${attraction.city}`} />

    <link rel="preload" as="image" href={hero} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webPageLd)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>
  </head>

  <body>
    <a class="skip" href="#contenido">Saltar al contenido principal</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="#inicio">
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="6" width="26" height="5" rx="1.5" fill="#16241d"></rect>
              <g fill="#16241d">
                <rect x="3" y="11" width="3.25" height="4"></rect>
                <rect x="12.75" y="11" width="3.25" height="4"></rect>
                <rect x="22.5" y="11" width="3.25" height="4"></rect>
              </g>
              <rect x="4" y="17" width="24" height="2.5" rx="1.25" fill="#16241d"></rect>
              <rect x="7" y="22" width="18" height="5" rx="1.5" fill="#16241d"></rect>
            </svg>
          </span>
          {attraction.shortName} {attraction.city}
        </a>
        <details class="section-menu" id="section-menu">
          <summary>Menú de secciones</summary>
        <nav class="site-nav" aria-label="Navegación principal">
          <a href="#sobre">Sobre</a>
          <a href="#mercado">El mercado</a>
          <a href="#galeria">Galería</a>
          <a href="#clima">Clima</a>
          <a href="#opiniones">Opiniones</a>
          <a href="#ubicacion">Ubicación</a>
          <a href="#horario">Horarios</a>
          <a href="#transporte">Cómo llegar</a>
          <a href="#servicios">Servicios</a>
          <a href="#alrededores">Alrededores</a>
          <a href="#temporadas">Cuándo ir</a>
          <a href="#recorridos">Recorridos</a>
          <a href="#historia">Historia</a>
          <a href="#divulgacion">Divulgación</a>
          <a href="#faq">FAQ</a>
          <a href="#fuentes">Fuentes</a>
        </nav>
        </details>
      </div>
    </header>

    <main id="contenido">
      <!-- ============================================================ HERO -->
      <section class="hero" id="inicio">
        <img
          class="hero__bg"
          src={hero}
          alt=""
          width="1600"
          height="1067"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero__veil" aria-hidden="true"></div>

        <div class="wrap hero__inner">
          <p class="hero__place">{attraction.region} · {attraction.country}</p>

          <nav class="breadcrumb" aria-label="Ruta de ubicación">
            {breadcrumbTrail.join(' → ')}
          </nav>

          <h1>{attraction.fullName} <em>({attraction.city})</em></h1>

          <p class="hero__tag">El <strong>{attraction.fullName}</strong>, conocido como <strong>{attraction.shortName}</strong>, es un centro de comercio popular de Asunción. Esta guía independiente ayuda a distinguir los sectores, consultar horarios y preparar la visita sin prometer que cada puesto esté abierto.</p>

          <div class="rating">
            <div class="rating__score" aria-hidden="true">{attraction.ratingDisplay}</div>
            <div>
              <div class="rating__stars" aria-hidden="true">★★★★<span>★</span></div>
              <div class="rating__meta">
                <strong>{attraction.ratingDisplay}</strong> de 5 · {attraction.reviewCountDisplay} opiniones
              </div>
            </div>
          </div>
          <p class="rating-source">
            {ratingSourceLine}
            <a href={attraction.mapsShareUrl} target="_blank" rel="noopener noreferrer">
              {viewAllLabel}↗
            </a>
          </p>

          <p class="rating-source">Ilustración original CC0 de esta guía; no es fotografía ni plano del mercado. <a href="https://creativecommons.org/publicdomain/zero/1.0/">Licencia</a>.</p>
          <div class="hero__actions">
            <a class="btn btn--gold" href="#ubicacion">Ver ubicación y mapa</a>
            <a class="btn btn--ghost-light" href={attraction.mapsShareUrl} target="_blank" rel="noopener noreferrer">
              Abrir en Google Maps ↗
            </a>
          </div>
        </div>
      </section>

      <!-- ===================================================== INFO STRIP -->
      <div class="wrap" style="position:relative">
        <div class="strip">
          <div class="strip__item">
            <div class="strip__k">Entrada</div>
            <div class="strip__v">Confirmar actividad</div>
            <div class="strip__s">Compras y servicios por separado</div>
          </div>
          <div class="strip__item">
            <div class="strip__k">Horario</div>
            <div class="strip__v">{attraction.hoursShort}</div>
            <div class="strip__s">Cada puesto maneja su horario</div>
          </div>
          <div class="strip__item">
            <div class="strip__k">Mejor momento</div>
            <div class="strip__v">{attraction.bestTime}</div>
            <div class="strip__s">Consultá primero al vendedor</div>
          </div>
          <div class="strip__item">
            <div class="strip__k">Barrio</div>
            <div class="strip__v">{attraction.neighborhood}</div>
            <div class="strip__s">Referencia general de zona</div>
          </div>
        </div>
      </div>

      <!-- ========================================================== SOBRE -->
      <section class="section" id="sobre" data-reveal><div class="wrap"><p class="eyebrow">Sobre el mercado</p><h2 class="sec-title">Mercado Municipal N°4, Asunción</h2><div class="prose" style="margin-top:22px"><p>La Municipalidad describe un mercado de rubros diversos: textiles, calzados, tecnología y alimentos. Es un lugar de trabajo además de un destino de visita; la oferta concreta depende de cada vendedor.</p><p>Paseo de los Yuyos y el edificio municipal sirven como referencias del entorno de Pettirossi y República Francesa. Confirmá el sector que buscás: esta guía no convierte ese punto de encuentro en la única entrada del conjunto.</p></div></div></section>

      <!-- ======================================================= EL MERCADO -->
      <section class="section section--tint" id="mercado" data-reveal>
        <div class="wrap">
          <p class="eyebrow">Qué encontrar</p>
          <h2 class="sec-title">Un mercado lleno de vida paraguaya</h2>
          <p class="lead">
            El {attraction.fullName} reúne puestos de alimentos, productos cotidianos y cultura urbana local
            en un solo paseo. Estas son sus caras más conocidas.
          </p>

          <div class="grid grid--4">
            {
              sections.map((s) => (
                <article class="card">
                  <div class="card__icon" aria-hidden="true">
                    {s.icon}
                  </div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ========================================================= GALERÍA -->
      <section class="section" id="galeria" data-reveal>
        <div class="wrap">
          <p class="eyebrow">Imágenes</p>
          <h2 class="sec-title">Galería del {attraction.shortName} en {attraction.city}</h2>
          <div class="gallery">
            {
              gallery.map((g, i) => (
                <figure>
                  <img
                    src={g.src}
                    alt={g.alt}
                    width="800"
                    height="600"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                  <figcaption>{g.caption}</figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <Weather />

      <!-- ======================================================= OPINIONES -->
      <section class="section section--dark" id="opiniones" data-reveal>
        <div class="wrap">
          <div class="center">
            <p class="eyebrow">Opiniones de visitantes</p>
            <h2 class="sec-title">Opiniones del {attraction.fullName}</h2>
            <p class="lead">
              Resumen de la valoración pública del mercado. Los textos individuales de las opiniones no se
              reproducen en esta página: se muestra únicamente la calificación agregada y su cantidad.
            </p>
          </div>

          <div class="center" style="margin-top:34px">
            <div class="reviews__score">{attraction.ratingDisplay}</div>
            <div class="reviews__count">
              <strong>{attraction.ratingDisplay}</strong> de 5 · {attraction.reviewCountDisplay} opiniones
            </div>
            <div class="reviews__stars" aria-hidden="true">★★★★<span>★</span></div>
            <p class="reviews__source">
              {ratingSourceLine}
              <a href={attraction.mapsShareUrl} target="_blank" rel="noopener noreferrer">
                {viewAllLabel}↗
              </a>
            </p>
          </div>

          <div class="grid grid--2">
            <div class="panel">
              <h3>Referencia publicada</h3>
              <ul>
                {reviewHighlights.map((p) => <li><span aria-hidden="true">✓</span><span>{p}</span></li>)}
              </ul>
            </div>
            <div class="panel">
              <h3>Límites y preparación</h3>
              <ul>
                {reviewNotes.map((n) => <li><span aria-hidden="true">ℹ</span><span>{n}</span></li>)}
              </ul>
            </div>
          </div>

          <div class="center">
            <p class="attribution">{reviewsAttribution}</p>
            <div style="margin-top:22px">
              <a
                class="btn btn--gold"
                href={attraction.mapsShareUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                📍 {viewAllLabel} ↗
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- ======================================================= UBICACIÓN -->
      <section class="section" id="ubicacion" data-reveal><div class="wrap"><p class="eyebrow">Cómo llegar</p><h2 class="sec-title">Ubicación y referencia municipal</h2><div class="loc-grid" style="margin-top:26px"><div class="prose"><p>{attraction.streetAddress}. La nota municipal del 28 de octubre de 2025 identifica ese lugar frente a la administración como punto de encuentro de una actividad concreta. Confirmá acceso, sector y lugar de llegada antes de salir.</p><p>El punto de Maps usado como referencia general es {attraction.latitude}, {attraction.longitude}; no representa todas las puertas del mercado.</p><h3 id="horario" class="sub-title">Horarios y domingos</h3><p>{attraction.hours}. No se verificó un horario común dominical; cada vendedor o sector puede variar. La Municipalidad informó un ciclo cultural nocturno el 21 de septiembre de 2026 y ampliación de actividad nocturna el 18 de octubre de 2026. Esas notas no publican una tabla semanal completa ni confirman horario dominical: consultá la actividad y el vendedor concretos.</p><a class="btn btn--primary" href={attraction.mapsShareUrl} target="_blank" rel="noopener noreferrer">Ver referencia en Google Maps ↗</a></div><div class="map-frame"><iframe src={attraction.mapsEmbedSrc} width="100%" height="450" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="Punto de referencia de Mercado 4 en Asunción"></iframe></div></div></div></section>

      <Transport />

      <Services />

      <!-- ==================================================== ALREDEDORES -->
      <section class="section section--tint" id="alrededores" data-reveal>
        <div class="wrap">
          <p class="eyebrow">Alrededores</p>
          <h2 class="sec-title">Lugares y atractivos alrededor del {attraction.shortName}</h2>
          <p class="lead">
            Elegí primero un sector y después planificá cualquier otro destino por separado. No se garantizan distancias ni conexiones inmediatas.
          </p>

          <div class="grid grid--2">
            {
              nearbyLandmarks.map((n) => (
                <article class="nearby__item">
                  <h3>{n.name}</h3>
                  <span class="nearby__tag">{n.tag}</span>
                  <p>{n.text}</p>
                </article>
              ))
            }
          </div>

          <p style="margin-top:26px" class="prose">
            Para novedades oficiales e información turística de la región, visitá el
            <a href={attraction.govTourismUrl} target="_blank" rel="noopener noreferrer">
              portal oficial de turismo de {attraction.country} / {attraction.region}
            </a>.
          </p>
        </div>
      </section>

      <Plan />

      <History />

      <Science />

      <!-- ============================================================= FAQ -->
      <section class="section section--tint" id="faq" data-reveal>
        <div class="wrap">
          <p class="eyebrow">Preguntas frecuentes</p>
          <h2 class="sec-title">FAQ sobre el {attraction.shortName} de {attraction.city}</h2>

          <div class="faq">
            {
              faqs.map((f, i) => (
                <details open={i === 0}>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ========================================================= FUENTES -->
      <section class="section" id="fuentes" data-reveal>
        <div class="wrap">
          <p class="eyebrow">Transparencia</p>
          <h2 class="sec-title">Fuentes y referencias</h2>
          <p class="lead">
            Esta guía no es un sitio oficial. Todas las referencias externas se citan a continuación para
            que puedas verificar cada dato en su fuente original.
          </p>

          <div class="sources">
            {
              sources.map((s) => (
                <article class="source-item">
                  <div class="source-item__head">
                    <h3>{s.title}</h3>
                    <span class="source-item__meta">{s.meta}</span>
                  </div>
                  <p>{s.desc}</p>
                  <a href={s.url} target="_blank" rel="noopener noreferrer">{s.linkLabel} ↗</a>
                </article>
              ))
            }
          </div>

          <p class="prose" style="margin-top:26px">
            Para información oficial y novedades de turismo regional, visitá el
            <a href={attraction.govTourismUrl} target="_blank" rel="noopener noreferrer">
              portal oficial de turismo de {attraction.country} / {attraction.region}
            </a>.
          </p>
        </div>
      </section>
      <section class="section section--tint" id="privacidad"><div class="wrap prose"><h2 class="sec-title">Privacidad y uso de la guía</h2><p>No hay cuentas, reservas, formulario de contacto ni analítica propia configurada. El mapa conecta con Google. El pronóstico, al cargar en el navegador, conecta directamente con Open-Meteo para las coordenadas fijas del mercado; no solicita tu geolocalización. Esos terceros pueden recibir datos técnicos de conexión. Consultá las políticas de <a href="https://policies.google.com/privacy">Google</a> y <a href="https://open-meteo.com/en/terms">Open-Meteo</a>.</p><p>Cloudflare aloja el sitio y puede tratar datos de conexión y rendimiento independientemente de esos servicios, según su <a href="https://www.cloudflare.com/privacypolicy/">política</a>. El navegador guarda archivos mediante caché y service worker para uso sin conexión; podés borrarlos desde sus ajustes. Una copia sin conexión puede estar desactualizada. No se garantiza que los terceros no usen cookies o identificadores.</p><p>Esta es una guía editorial, no el operador ni una garantía de apertura, seguridad, inventario o reserva. Cada vendedor, actividad y enlace externo tiene sus condiciones. <a href="#fuentes">Revisá fuentes y fechas</a> antes de decidir.</p></div></section>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="site-footer__grid">
          <div>
            <h4>{attraction.fullName}</h4>
            <p>
              Guía independiente y sin ánimo de lucro de turismo y divulgación del {attraction.fullName} ({attraction.shortName}) en
              {attraction.city}, {attraction.region}, {attraction.country}.
            </p>
            <p style="margin-top:12px">
              {attraction.streetAddress} · Referencia general de zona
            </p>
            <p style="margin-top:12px">
              Coordenadas: {attraction.latitude}, {attraction.longitude}
            </p>
          </div>

          <div>
            <h4>Secciones</h4>
            <ul>
              <li><a href="#sobre">Sobre el mercado</a></li>
              <li><a href="#mercado">Qué encontrar</a></li>
              <li><a href="#galeria">Galería</a></li>
              <li><a href="#clima">Clima y pronóstico</a></li>
              <li><a href="#opiniones">Opiniones</a></li>
              <li><a href="#ubicacion">Ubicación</a></li>
              <li><a href="#horario">Horarios</a></li>
              <li><a href="#transporte">Cómo llegar</a></li>
              <li><a href="#servicios">Servicios</a></li>
              <li><a href="#temporadas">Cuándo ir</a></li>
              <li><a href="#recorridos">Recorridos</a></li>
              <li><a href="#historia">Historia y relatos</a></li>
              <li><a href="#divulgacion">Divulgación</a></li>
              <li><a href="#responsabilidad">Visita responsable</a></li>
              <li><a href="#faq">Preguntas frecuentes</a></li>
              <li><a href="#fuentes">Fuentes</a></li>
            </ul>
          </div>

          <div>
            <h4>Enlaces externos</h4><p><a href="#privacidad">Privacidad y condiciones</a></p>
            <ul>
              <li>
                <a href={attraction.mapsShareUrl} target="_blank" rel="noopener noreferrer">
                  Google Maps — {attraction.shortName} ↗
                </a>
              </li>
              <li>
                <a href={attraction.govTourismUrl} target="_blank" rel="noopener noreferrer">
                  SENATUR — Turismo oficial del Paraguay ↗
                </a>
              </li>
              <li>
                <a href={attraction.municipalityUrl} target="_blank" rel="noopener noreferrer">
                  Municipalidad de Asunción ↗
                </a>
              </li>
              <li>
                <a href={attraction.juntaMunicipalUrl} target="_blank" rel="noopener noreferrer">
                  Junta Municipal de Asunción ↗
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="site-footer__bottom">
          <span>
            No es un sitio oficial del Mercado 4 ni de la Municipalidad de Asunción. Las marcas y los
            contenidos de Google Maps pertenecen a sus respectivos propietarios.
          </span>
          <span>
            Referencia de opiniones de Google Maps · {attraction.syncDate} ·
            <a href={attraction.mapsShareUrl} target="_blank" rel="noopener noreferrer">{viewAllLabel} ↗</a>
          </span>
        </div>
      </div>
    </footer>

    <noscript>
      <style>[data-reveal]{opacity:1 !important;transform:none !important}</style>
    </noscript>

    <script is:inline>
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          Array.prototype.forEach.call(els, function (el) { el.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.04 });
        Array.prototype.forEach.call(els, function (el) { io.observe(el); });
      })();
    </script>

    <script is:inline>
      (() => {
        const menu = document.getElementById('section-menu');
        if (!menu) return;
        menu.addEventListener('click', (event) => {
          if (event.target instanceof Element && event.target.closest('a[href^="#"]')) menu.open = false;
        });
        menu.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') { menu.open = false; menu.querySelector('summary')?.focus(); }
        });
      })();
    </script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
