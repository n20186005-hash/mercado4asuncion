---
import {
  getWeather,
  describeCode,
  dailyAdvice,
  umbrellaHint,
  formatDayLabel,
  formatTime,
} from '../lib/weather';
import { attraction } from '../config/site';

const weather = await getWeather(attraction.latitude, attraction.longitude);
const current = weather?.current ?? null;
const days = weather?.days ?? [];
const now = describeCode(current?.weatherCode ?? days[0]?.weatherCode);
const hint = umbrellaHint(current, days);
const hasData = Boolean(current || days.length > 0);

const round = (n: number | null | undefined) =>
  n === null || n === undefined ? '—' : String(Math.round(n));
const mm = (n: number | null | undefined) =>
  n === null || n === undefined ? '—' : `${n.toFixed(1)} mm`;
const pct = (n: number | null | undefined) =>
  n === null || n === undefined ? '—' : `${Math.round(n)}%`;
const kmh = (n: number | null | undefined) =>
  n === null || n === undefined ? '—' : `${Math.round(n)} km/h`;
---

<section
  class="section section--tint"
  id="clima"
  data-reveal
  data-lat={attraction.latitude}
  data-lng={attraction.longitude}
>
  <div class="wrap">
    <p class="eyebrow">Clima</p>
    <h2 class="sec-title">Clima y pronóstico en el {attraction.shortName}</h2>
    <p class="lead">
      Condiciones actuales y pronóstico de los próximos días en {attraction.city}. El {attraction.shortName} se
      recorre a pie y con poca sombra: revisar la temperatura y la probabilidad de lluvia antes de salir cambia
      bastante la experiencia.
    </p>

    <div class="wx">
      <div class="wx__now">
        <div class="wx__now-top">
          <div class="wx__icon" data-wx="icon" aria-hidden="true">{now.icon}</div>
          <div>
            <div class="wx__temp">
              <span data-wx="temp">{round(current?.temperature ?? days[0]?.tMax)}</span>°
            </div>
            <div class="wx__desc" data-wx="desc">{now.label}</div>
          </div>
        </div>

        <ul class="wx__stats">
          <li>
            <span class="wx__k">Sensación</span>
            <span class="wx__v" data-wx="feels">{round(current?.apparentTemperature)}°</span>
          </li>
          <li>
            <span class="wx__k">Humedad</span>
            <span class="wx__v" data-wx="hum">{pct(current?.humidity)}</span>
          </li>
          <li>
            <span class="wx__k">Viento</span>
            <span class="wx__v" data-wx="wind">{kmh(current?.windSpeed)}</span>
          </li>
          <li>
            <span class="wx__k">Lluvia 1 h</span>
            <span class="wx__v" data-wx="precip">{mm(current?.precipitation)}</span>
          </li>
        </ul>

        <p class="wx__hint">
          <strong>¿Llevo paraguas? </strong>
          <span data-wx="hint">{hint}</span>
        </p>
        <p class="wx__updated">
          Actualizado: <span data-wx="updated">{formatTime(current?.time) || 'hace instantes'}</span>
        </p>
      </div>

      <div class="wx__days" data-wx="days">
        {
          days.map((d, i) => {
            const c = describeCode(d.weatherCode);
            return (
              <article class="wx__day">
                <div class="wx__day-name">{i === 0 ? 'Hoy' : formatDayLabel(d.date)}</div>
                <div class="wx__day-icon" aria-hidden="true">{c.icon}</div>
                <div class="wx__day-temp">
                  <strong>{round(d.tMax)}°</strong> <span>{round(d.tMin)}°</span>
                </div>
                <div class="wx__day-pop">
                  {d.precipitationProbability === null || d.precipitationProbability === undefined
                    ? ''
                    : `💧 ${Math.round(d.precipitationProbability)}%`}
                </div>
                <div class="wx__day-desc">{c.label}</div>
                <div class="wx__day-tip">{dailyAdvice(d)}</div>
              </article>
            );
          })
        }
      </div>
    </div>

    <p class="wx__note" data-wx="nodata" hidden={hasData}>
      El pronóstico detallado no está disponible en este momento. Volvé a cargar la página en unos minutos
      para ver las condiciones actuales y la previsión de los próximos días en {attraction.city}.
    </p>

    <p class="wx__note">
      Recomendación general: en verano el pico de calor se da entre las 12:00 y las 15:00, y las lluvias
      intensas son más frecuentes por la tarde. Si querés recorrer con comodidad, apuntá a la mañana.
    </p>
  </div>
</section>

<script>
  import {
    getWeather,
    describeCode,
    dailyAdvice,
    umbrellaHint,
    formatDayLabel,
    formatTime,
  } from '../lib/weather';

  const root = document.getElementById('clima');

  if (root) {
    const lat = Number(root.dataset.lat);
    const lng = Number(root.dataset.lng);

    const set = (key: string, value: string) => {
      root.querySelectorAll(`[data-wx="${key}"]`).forEach((el) => {
        el.textContent = value;
      });
    };

    const round = (n: number | null | undefined) =>
      n === null || n === undefined ? '—' : String(Math.round(n));
    const pct = (n: number | null | undefined) =>
      n === null || n === undefined ? '—' : `${Math.round(n)}%`;
    const kmh = (n: number | null | undefined) =>
      n === null || n === undefined ? '—' : `${Math.round(n)} km/h`;
    const mm = (n: number | null | undefined) =>
      n === null || n === undefined ? '—' : `${n.toFixed(1)} mm`;

    getWeather(lat, lng).then((w) => {
      if (!w || (!w.current && w.days.length === 0)) return;

      const c = w.current;
      const d0 = w.days[0];
      const code = describeCode(c?.weatherCode ?? d0?.weatherCode);

      set('icon', code.icon);
      set('temp', round(c?.temperature ?? d0?.tMax));
      set('desc', code.label);
      set('feels', `${round(c?.apparentTemperature)}°`);
      set('hum', pct(c?.humidity));
      set('wind', kmh(c?.windSpeed));
      set('precip', mm(c?.precipitation));
      set('hint', umbrellaHint(c, w.days));
      set('updated', formatTime(c?.time) || 'hace instantes');

      const container = root.querySelector('[data-wx="days"]');
      if (container && w.days.length) {
        container.innerHTML = w.days
          .map((d, i) => {
            const cd = describeCode(d.weatherCode);
            const pop =
              d.precipitationProbability === null || d.precipitationProbability === undefined
                ? ''
                : `<div class="wx__day-pop">💧 ${Math.round(d.precipitationProbability)}%</div>`;
            return `<article class="wx__day">
              <div class="wx__day-name">${i === 0 ? 'Hoy' : formatDayLabel(d.date)}</div>
              <div class="wx__day-icon" aria-hidden="true">${cd.icon}</div>
              <div class="wx__day-temp"><strong>${round(d.tMax)}°</strong> <span>${round(d.tMin)}°</span></div>
              ${pop}
              <div class="wx__day-desc">${cd.label}</div>
              <div class="wx__day-tip">${dailyAdvice(d)}</div>
            </article>`;
          })
          .join('');
      }

      const nodata = root.querySelector('[data-wx="nodata"]');
      if (nodata) nodata.setAttribute('hidden', '');
    });
  }
</script>
